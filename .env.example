# Copy to .env and fill in POSTGRES_PASSWORD. .env is never committed.
# The same password is used by Postgres and by the API.
# Compose refuses to start while POSTGRES_PASSWORD is empty or missing.
POSTGRES_PASSWORD=

# Host ports (both are bound to 127.0.0.1 only).
API_PORT=8000
UI_PORT=8081

# Address of the API as the BROWSER sees it. It is baked into the UI bundle at build time.
# By default it follows API_PORT (http://localhost:<API_PORT>). Uncomment to override, and
# after any change run: docker compose up -d --build
# VITE_API_BASE=http://localhost:8000

# Origins the API accepts through CORS (comma-separated). They must contain the UI address.
# By default they follow UI_PORT (http://localhost:<UI_PORT> and http://127.0.0.1:<UI_PORT>).
# UI_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Where the ui service takes its sources from. By default it is the main branch of the
# public wishlist-ui repository, so cloning wishlist-api alone is enough. To build the UI from
# a local clone instead (for example to test unpublished changes), uncomment:
# UI_CONTEXT=../wishlist-ui

# Only for the dev profile (docker compose --profile dev ...).
# UI_DEV_PATH is the local wishlist-ui clone that is mounted into the dev UI container.
UI_DEV_PATH=../wishlist-ui
API_DEV_PORT=8100
UI_DEV_PORT=5174
VITE_DEV_API_BASE=http://localhost:8100
UI_DEV_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
